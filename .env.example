# Public controller/contact details and Privacy Notice approval are versioned in:
#   src/config/public-identity.json
# Do not put the public P.O. box behind an environment variable.

# Optional analytics measurement-ID override:
# VITE_GA_MEASUREMENT_ID=G-DD2217GBC7

# Niran Storytime remains fail-closed unless explicitly enabled for a reviewed
# build. Production must keep this false until website Issue #5 authorizes launch.
VITE_NIRAN_STORYTIME_ENABLED=false

# Local development only. When set, Vite proxies the exact signup endpoint to a
# localhost Wrangler process. Non-local and HTTPS targets are rejected.
# SIGNUP_WORKER_DEV_URL=http://127.0.0.1:8787
