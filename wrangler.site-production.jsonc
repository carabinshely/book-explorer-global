{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bronerbooks-site-production",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
