{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run privacy:check && npm run sitemap && vite build && node scripts/generate-book-pages.mjs",
    "build:dev": "vite build --mode development",
    "build:verify": "node scripts/build-verification.mjs",
    "sitemap": "npm run seo:sitemap",
    "lint": "eslint .",
    "test": "vitest run && node --test scripts/*.node-test.mjs",
    "test:watch": "vitest",
    "preview": "vite preview",
    "privacy:check": "node scripts/validate-public-config.mjs",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "seo:check:committed": "npm run seo:sitemap && git diff --exit-code -- public/sitemap.xml",
    "seo:check:dist": "node scripts/seo-check.mjs --dist",
    "seo:smoke": "npm run seo:check && npm run seo:check:committed && npm run build && npm run seo:check:dist",
    "links:check": "node scripts/links-dx.mjs check --environment preview",
    "links:test": "node --test scripts/links-dx.node-test.mjs",
    "links:preview": "node scripts/links-dx.mjs preview --environment preview",
    "links:smoke:local": "node scripts/links-dx.mjs smoke-local",
    "links:deploy:preview": "node scripts/links-dx.mjs deploy --environment preview",
    "links:smoke:preview": "node scripts/links-dx.mjs smoke --environment preview",
    "links:deploy:production": "node scripts/links-dx.mjs deploy --environment production",
    "links:smoke:production": "node scripts/links-dx.mjs smoke --environment production",
    "links:rollback": "node scripts/links-dx.mjs rollback",
    "links:docs:check": "node scripts/check-links-docs.mjs",
    "links:proof:check": "node worker/release-proof.mjs check",
    "links:proof:test": "node --test worker/release-proof.node-test.mjs",
    "links:proof:evidence": "node worker/release-proof.mjs validate-evidence",
    "links:preview:parity": "node worker/release-proof.mjs preview-parity",
    "links:destination-health": "node worker/release-proof.mjs destination-health",
    "links:canonical-smoke": "node worker/release-proof.mjs canonical-smoke",
    "links:attach-route": "node scripts/links-dx.mjs attach-route",
    "links:detach-route": "node scripts/links-dx.mjs detach-route",
    "signup:test": "vitest run signup-worker src/components/niran/NiranStorytimeSignup.test.tsx src/lib/niranCampaign.test.ts",
    "signup:types": "node scripts/generate-signup-worker-types.mjs",
    "signup:types:check": "npm run signup:types && git diff --exit-code -- signup-worker/worker-configuration.d.ts",
    "signup:typecheck": "npm run signup:types && tsc -p signup-worker/tsconfig.json --noEmit",
    "signup:check:preview": "npm run signup:typecheck && wrangler deploy --dry-run --config signup-worker/wrangler.jsonc --env preview",
    "signup:check:production": "npm run signup:typecheck && wrangler deploy --dry-run --config signup-worker/wrangler.jsonc --env production",
    "signup:check": "npm run signup:test && npm run signup:types:check && tsc -p signup-worker/tsconfig.json --noEmit && wrangler deploy --dry-run --config signup-worker/wrangler.jsonc --env preview && wrangler deploy --dry-run --config signup-worker/wrangler.jsonc --env production",
    "signup:deploy:preview": "wrangler deploy --config signup-worker/wrangler.jsonc --env preview",
    "signup:deploy:production": "wrangler deploy --config signup-worker/wrangler.jsonc --env production"
  },
